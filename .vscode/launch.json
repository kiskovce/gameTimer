{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug gametimer",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/gametimer",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "build (debug)",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
